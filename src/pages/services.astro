---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteImage from "@/components/SiteImage.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import Faq from "@/components/Faq.astro";
import { site } from "@/config/site";

const page = site.pages.services;
---

<Layout title={page.heading} description={page.lede} faq={page.faq}>
  <Nav />
  <main id="main">
    <PageHeader title={page.heading} lede={page.lede} />
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <p class="max-w-3xl text-lg text-gray-800">{page.intro}</p>
        <div class="mt-14 space-y-20">
          {site.services.map((s, i) => (
            <article class="grid md:grid-cols-2 gap-10 items-center">
              <div class={`aspect-[4/3] overflow-hidden rounded-2xl bg-mist ${i % 2 ? "md:order-2" : ""}`}>
                <SiteImage image={s.image} class="h-full w-full object-cover" sizes="(min-width: 768px) 50vw, 100vw" widths={[500, 900]} />
              </div>
              <div>
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-navy text-accent"><Icon name={s.icon} class="w-6 h-6" /></span>
                <h2 class="mt-5 text-3xl font-extrabold text-navy">{s.name}</h2>
                <p class="mt-3 text-lg text-gray-800">{s.description}</p>
                <p class="mt-6 font-display text-sm font-bold text-brand">{s.highlightsLabel}</p>
                <ul class="mt-2 space-y-2">
                  {s.highlights.map((h) => (
                    <li class="flex gap-3"><Icon name="check" class="w-5 h-5 mt-1 shrink-0 text-accent" /><span>{h}</span></li>
                  ))}
                </ul>
                <a href={`/services/${s.slug}`} class="btn-primary mt-8">{site.ui.servicesLink}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <Faq items={page.faq} />
    <CtaBand />
  </main>
  <Footer />
</Layout>
