---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { site, telHref, areasFormatted } from "@/config/site";
import SiteImage from "@/components/SiteImage.astro";

const faq = site.pages.services.faq ?? [];
---

<Layout
  title="Services"
  description={`${site.business.name} offers ${site.services.map((s) => s.name).join(", ")} and more. Serving ${site.business.serviceAreas.join(", ")}.`}
  faq={faq}
>
  <Nav />

  <section class="py-12 px-4" style="background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%)">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest mb-2" style="color: var(--color-brand)">
        Our Work
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-2">Services</h1>
      <p class="text-gray-300">Serving {areasFormatted}</p>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          site.services.map((service) => (
            <a href={`/services/${service.slug}`} class="group block border-2 border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-gray-200 transition-all">
              <SiteImage
                image={service.image}
                class="h-44 w-full object-cover"
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
              />
              <div class="p-7">
              <div class="text-4xl mb-4">{service.icon}</div>
              <h2 class="font-display text-xl font-bold mb-3 group-hover:underline" style="color: var(--color-navy)">
                {service.name}
              </h2>
              <p class="text-gray-600 leading-relaxed text-sm mb-4">{service.description}</p>
              <span class="text-sm font-semibold" style="color: var(--color-brand)">Learn more →</span>
              </div>
            </a>
          ))
        }
      </div>

      {faq.length > 0 && (
        <div class="mt-16 max-w-3xl">
          <h2 class="font-display text-2xl sm:text-3xl font-bold mb-8" style="color: var(--color-navy)">
            Frequently asked
          </h2>
          <div class="space-y-6">
            {faq.map((qa) => (
              <div>
                <h3 class="font-semibold text-gray-900 mb-1.5">{qa.q}</h3>
                <p class="text-gray-600 leading-relaxed text-sm">{qa.a}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-16 bg-gray-50 rounded-2xl p-10 text-center">
        <h3 class="font-display text-2xl font-bold mb-3" style="color: var(--color-navy)">
          Don't see what you need?
        </h3>
        <p class="text-gray-600 mb-6">Give us a call and ask — if it's {site.business.trade.toLowerCase()} related, it's worth a conversation.</p>
        <a
          href={telHref}
          class="inline-flex items-center gap-2 px-6 py-4 rounded-lg text-white font-bold transition-opacity hover:opacity-90"
          style="background-color: var(--color-brand)"
        >
          Call {site.business.phone}
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
