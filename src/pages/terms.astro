---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { site, telHref, mailtoHref } from "@/config/site";
---

<Layout
  title="Terms of Service"
  description={`Terms of service for ${site.business.name}.`}
>
  <Nav />

  <section class="py-12 px-4" style="background-color: var(--color-navy)">
    <div class="max-w-6xl mx-auto">
      <h1 class="font-display text-4xl font-bold text-white mb-2">Terms of Service</h1>
      <p class="text-gray-300">Last updated: {new Date().getFullYear()}</p>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">

      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Using this site</h2>
      <p class="text-gray-700 leading-relaxed mb-6">
        This website belongs to {site.business.name}. By using it, you agree to these terms. If you don't
        agree, please don't use the site.
      </p>

      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Quote requests</h2>
      <p class="text-gray-700 leading-relaxed mb-6">
        Submitting the contact form is a request for a quote — not a binding contract. A job is only
        confirmed when both parties agree in writing to a scope and price.
      </p>

      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Accuracy</h2>
      <p class="text-gray-700 leading-relaxed mb-6">
        We keep the information on this site up to date, but we can't guarantee it's always complete or
        error-free. For the most current pricing and availability, call us directly.
      </p>

      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Liability</h2>
      <p class="text-gray-700 leading-relaxed mb-6">
        {site.business.name} is not liable for any damages arising from your use of this website or reliance
        on information found here.
      </p>

      <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Contact</h2>
      <p class="text-gray-700 leading-relaxed">
        Questions? Call{" "}
        <a href={telHref} class="font-semibold" style="color: var(--color-brand)">
          {site.business.phone}
        </a>{" "}
        or email{" "}
        <a href={mailtoHref} class="font-semibold" style="color: var(--color-brand)">
          {site.business.email}
        </a>.
      </p>

    </div>
  </section>

  <Footer />
</Layout>
