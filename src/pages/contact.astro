---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import ContactForm from "@/components/ContactForm.astro";
import Footer from "@/components/Footer.astro";
import { site, telHref, mailtoHref, hoursDisplay, reviews } from "@/config/site";

const contact = site.pages.contact;
---

<Layout
  title="Contact"
  description={`Contact ${site.business.name}. Call ${site.business.phone} or send a request through the site. Serving ${site.business.serviceAreas.join(", ")}.`}
>
  <Nav />

  <section class="py-12 px-4" style="background-color: var(--color-navy)">
    <div class="max-w-6xl mx-auto">
      <h1 class="font-display text-4xl font-bold text-white mb-2">Contact Us</h1>
      <p class="text-gray-300 max-w-3xl">{contact.responseLine}</p>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-2xl font-bold mb-6" style="color: var(--color-navy)">Get in Touch</h2>

        <div class="space-y-5">
          <div class="flex items-start gap-4">
            <div class="text-2xl" aria-hidden="true">📞</div>
            <div>
              <div class="font-semibold text-gray-800 text-sm mb-0.5">Phone</div>
              <a href={telHref} class="text-lg font-bold" style="color: var(--color-brand)">
                {site.business.phone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="text-2xl" aria-hidden="true">✉️</div>
            <div>
              <div class="font-semibold text-gray-800 text-sm mb-0.5">Email</div>
              <a href={mailtoHref} class="text-gray-700 hover:text-gray-900 transition-colors">
                {site.business.email}
              </a>
            </div>
          </div>

          {hoursDisplay.length > 0 && (
            <div class="flex items-start gap-4">
              <div class="text-2xl" aria-hidden="true">🕗</div>
              <div>
                <div class="font-semibold text-gray-800 text-sm mb-1">Hours</div>
                <dl class="text-sm text-gray-600 space-y-0.5">
                  {hoursDisplay.map((h) => (
                    <div class="flex gap-3">
                      <dt class="w-20 font-medium text-gray-700">{h.days}</dt>
                      <dd>{h.time}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          )}

          <div class="flex items-start gap-4">
            <div class="text-2xl" aria-hidden="true">📍</div>
            <div>
              <div class="font-semibold text-gray-800 text-sm mb-0.5">Service Areas</div>
              <div class="text-gray-600">{site.business.serviceAreas.join(" · ")}</div>
            </div>
          </div>
        </div>

        {reviews && (
          <a
            href={reviews.url}
            target="_blank"
            rel="noopener"
            class="mt-8 inline-flex items-center gap-2 rounded-lg border border-gray-200 px-4 py-3 text-sm hover:border-gray-400 transition-colors"
          >
            <span aria-hidden="true" style="color: var(--color-brand)">★★★★★</span>
            <span class="font-semibold text-gray-800">{reviews.rating.toFixed(1)}</span>
            <span class="text-gray-600">from {reviews.count} {reviews.source} review{reviews.count === 1 ? "" : "s"}</span>
          </a>
        )}

        {contact.expectBullets.length > 0 && (
          <div class="mt-10 bg-gray-50 rounded-2xl p-7">
            <h3 class="font-display text-lg font-bold mb-4" style="color: var(--color-navy)">
              What to expect
            </h3>
            <ol class="space-y-4">
              {contact.expectBullets.map((bullet, i) => (
                <li class="flex gap-4">
                  <span
                    class="flex-shrink-0 w-7 h-7 rounded-full text-white font-bold flex items-center justify-center text-xs"
                    style="background-color: var(--color-brand)"
                  >{i + 1}</span>
                  <span class="text-gray-700 text-sm leading-relaxed pt-0.5">{bullet}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <ContactForm />
    </div>
  </section>

  <Footer />
</Layout>
