---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import ContactForm from "@/components/ContactForm.astro";
import Icon from "@/components/Icon.astro";
import { site, telHref, mailtoHref, hoursDisplay, formatList } from "@/config/site";

const page = site.pages.contact;
const ui = site.ui;
---

<Layout title={page.heading} description={`${page.lede} Call ${site.business.phone} or send us a message.`}>
  <Nav />
  <main id="main">
    <PageHeader title={page.heading} lede={page.lede} />
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.3fr] gap-12 items-start">
        <div>
          <p class="text-lg text-gray-800">{page.responseLine}</p>
          <dl class="mt-8 space-y-6 font-display">
            <div class="flex gap-4">
              <Icon name="phone" class="w-6 h-6 shrink-0 text-accent" />
              <div><dt class="text-sm font-bold text-brand">{ui.phoneHeading}</dt><dd><a href={telHref} class="text-xl font-extrabold text-navy hover:underline">{site.business.phone}</a></dd></div>
            </div>
            <div class="flex gap-4">
              <Icon name="mail" class="w-6 h-6 shrink-0 text-accent" />
              <div><dt class="text-sm font-bold text-brand">{ui.emailHeading}</dt><dd><a href={mailtoHref} class="font-semibold text-navy hover:underline break-all">{site.business.email}</a></dd></div>
            </div>
            <div class="flex gap-4">
              <Icon name="clock" class="w-6 h-6 shrink-0 text-accent" />
              <div><dt class="text-sm font-bold text-brand">{ui.hoursHeading}</dt><dd class="text-navy">{hoursDisplay.map((h) => <span class="block">{h.days}: {h.time}</span>)}</dd></div>
            </div>
            <div class="flex gap-4">
              <Icon name="pin" class="w-6 h-6 shrink-0 text-accent" />
              <div><dt class="text-sm font-bold text-brand">{ui.addressHeading}</dt><dd class="text-navy">{site.business.streetAddress}<br />{site.business.address} {site.business.postalCode}</dd></div>
            </div>
          </dl>
          <p class="mt-8 text-gray-800">{ui.footer.servingPrefix} {formatList(site.business.serviceAreas)}.</p>
          <div class="mt-10 border-t-2 border-gold pt-6">
            <h2 class="text-xl font-bold text-navy">{page.partnerHeading}</h2>
            <p class="mt-2 text-gray-800">{page.partnerBody}</p>
          </div>
        </div>
        <div class="order-first lg:order-none"><ContactForm /></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
