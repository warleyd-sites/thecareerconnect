---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteImage from "@/components/SiteImage.astro";
import Icon from "@/components/Icon.astro";
import CtaBand from "@/components/CtaBand.astro";
import { site, type Service } from "@/config/site";

export function getStaticPaths() {
  return site.services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const d = service.detail;
const others = site.services.filter((s) => s.slug !== service.slug);
---

<Layout title={service.name} description={d.lede}>
  <Nav />
  <main id="main">
    <PageHeader title={service.name} lede={d.lede} />

    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.2fr_1fr] gap-12 items-start">
        <div>
          <p class="text-lg sm:text-xl leading-relaxed text-gray-800">{d.intro}</p>
          <p class="mt-8 font-display text-sm font-bold text-brand">{service.highlightsLabel}</p>
          <ul class="mt-3 grid sm:grid-cols-2 gap-3">
            {service.highlights.map((h) => (
              <li class="flex gap-3 rounded-lg bg-mist px-4 py-3"><Icon name="check" class="w-5 h-5 mt-1 shrink-0 text-accent" /><span>{h}</span></li>
            ))}
          </ul>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-2xl rounded-tr-[5rem] bg-mist">
          <SiteImage image={service.image} class="h-full w-full object-cover" sizes="(min-width: 1024px) 40vw, 100vw" widths={[500, 900]} loading="eager" />
        </div>
      </div>
    </section>

    <section class="bg-navy text-white py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold">{site.ui.servicesApproachHeading}</h2>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {d.approach.map((a) => (
            <div class="border-t-2 border-gold pt-5">
              <h3 class="text-lg font-bold">{a.title}</h3>
              <p class="mt-2 text-white/85 text-[0.97rem]">{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold text-navy">{site.ui.servicesOfferedHeading}</h2>
        <dl class="mt-10 grid md:grid-cols-2 gap-x-12 border-t border-gray-200">
          {d.whatsIncluded.map((w) => (
            <div class="border-b border-gray-200 py-6">
              <dt class="font-display text-lg font-bold text-navy">{w.title}</dt>
              <dd class="mt-1 text-gray-800">{w.body}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-12 max-w-3xl font-body italic text-2xl leading-snug text-navy">{d.closing}</p>
      </div>
    </section>

    <section class="pb-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-sm font-bold text-brand">{site.ui.otherServicesHeading}</h2>
        <ul class="mt-4 flex flex-wrap gap-3">
          {others.map((s) => (
            <li><a href={`/services/${s.slug}`} class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2 font-display text-sm font-semibold text-navy hover:border-brand hover:text-brand"><Icon name={s.icon} class="w-4 h-4" />{s.name}</a></li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
