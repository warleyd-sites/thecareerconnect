---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import SiteImage from "@/components/SiteImage.astro";
import Icon from "@/components/Icon.astro";
import TestimonialVideo from "@/components/TestimonialVideo.astro";
import CtaBand from "@/components/CtaBand.astro";
import BookingButton from "@/components/BookingButton.astro";
import { site } from "@/config/site";

const home = site.home;
const ui = site.ui;
const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Layout title={site.business.tagline}>
  <Nav />
  <main id="main">
    <!-- Hero: the tagline in italic Baskerville, as the brand kit sets it -->
    <section class="relative overflow-hidden bg-navy text-white px-4 sm:px-6">
      <div class="relative z-10 max-w-6xl mx-auto pt-14 pb-28 sm:pt-20 sm:pb-36 grid lg:grid-cols-[1.15fr_1fr] gap-12 items-center">
        <div>
          <p class="gold-rule max-w-md font-display text-xs font-semibold tracking-[0.2em]">
            <span class="text-white/90">{site.business.name.toUpperCase()}</span>
          </p>
          <h1 class="mt-6 font-body italic font-normal text-5xl sm:text-6xl lg:text-7xl leading-[1.05] tracking-tight">
            {site.business.tagline}
          </h1>
          <p class="mt-6 max-w-xl text-lg sm:text-xl text-white/85">{site.business.pitch}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <BookingButton />
            <a href="/services" class="btn-secondary text-white">{ui.hero.secondaryCta}</a>
          </div>
        </div>
        <div class="relative">
          <div class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] overflow-hidden rounded-[2rem] rounded-tl-[6rem] ring-1 ring-white/10">
            <SiteImage image={site.business.heroImage} class="h-full w-full object-cover" sizes="(min-width: 1024px) 45vw, 100vw" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
      <svg aria-hidden="true" class="absolute bottom-0 left-0 w-full h-20 sm:h-32" viewBox="0 0 1440 140" preserveAspectRatio="none">
        <path d="M0 140 C 360 30, 900 20, 1440 80 L1440 140 Z" fill="white" />
        <path d="M0 128 C 380 18, 920 6, 1440 66 L1440 76 C 920 20, 380 36, 0 140 Z" fill="var(--color-accent)" />
      </svg>
    </section>

    <!-- Intro and why us -->
    <section class="py-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.4fr] gap-12">
        <div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">{home.introHeading}</h2>
          <p class="mt-5 text-lg text-gray-800">{home.aboutParagraph}</p>
        </div>
        <div>
          <h3 class="font-display text-sm font-bold text-brand">{home.pillarsHeading}</h3>
          <div class="mt-4 grid sm:grid-cols-3 gap-8">
            {home.pillars.map((p) => (
              <div class="border-t-2 border-gold pt-5">
                <h4 class="text-xl font-bold text-navy">{p.title}</h4>
                <p class="mt-2 text-[0.97rem] text-gray-800">{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Audiences -->
    <section class="pb-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">{home.audiencesHeading}</h2>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
          {home.audiences.map((a) => (
            <div>
              <div class="aspect-[4/3] overflow-hidden rounded-xl bg-mist">
                <SiteImage image={a.image} class="h-full w-full object-cover" sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" widths={[400, 700]} />
              </div>
              <h3 class="mt-5 text-xl font-bold text-navy">{a.title}</h3>
              <p class="mt-2 text-[0.97rem] text-gray-800">{a.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services as an index list, not a card grid -->
    <section class="bg-navy text-white py-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-2xl">
          <h2 class="text-3xl sm:text-4xl font-extrabold">{home.servicesHeading}</h2>
          <p class="mt-4 text-lg text-white/85">{home.servicesIntro}</p>
        </div>
        <ul class="mt-12 grid md:grid-cols-2 gap-x-12 border-t border-white/15">
          {site.services.map((s) => (
            <li class="border-b border-white/15">
              <a href={`/services/${s.slug}`} class="group flex gap-5 py-8">
                <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-white/10 text-accent group-hover:bg-accent group-hover:text-navy transition-colors">
                  <Icon name={s.icon} />
                </span>
                <span>
                  <span class="block font-display text-xl font-bold group-hover:text-accent transition-colors">{s.name}</span>
                  <span class="mt-1 block text-white/80">{s.description}</span>
                  <span class="mt-3 block font-display text-sm text-gold">{s.highlights.join(" / ")}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Founder -->
    <section class="py-20 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-[auto_1fr] gap-10 items-center">
        <div class="mx-auto w-56 h-56 sm:w-64 sm:h-64 overflow-hidden rounded-full ring-8 ring-mist">
          <SiteImage image={site.about.ownerImage} class="h-full w-full object-cover" sizes="256px" widths={[256, 512]} />
        </div>
        <figure>
          <blockquote class="font-body italic text-2xl sm:text-3xl leading-snug text-navy">“{site.about.ownerQuote}”</blockquote>
          <figcaption class="mt-5 font-display">
            <span class="font-bold text-navy">{site.about.ownerName}</span><span class="text-gray-700">, {site.about.ownerTitle}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="pb-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">{home.testimonialsHeading}</h2>
          <a href="/testimonials" class="font-display font-semibold text-brand hover:underline">{ui.allTestimonials}</a>
        </div>
        <div class="mt-10 grid md:grid-cols-3 gap-8">
          {site.testimonials.items.map((t) => <TestimonialVideo item={t} />)}
        </div>
      </div>
    </section>

    <!-- Blog -->
    <section class="pb-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto border-t border-gray-200 pt-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">{home.blogHeading}</h2>
            <p class="mt-2 text-gray-800">{home.blogIntro}</p>
          </div>
          <a href="/blog" class="font-display font-semibold text-brand hover:underline">{ui.allPosts}</a>
        </div>
        <div class="mt-10 grid md:grid-cols-3 gap-8">
          {posts.map((p) => (
            <article>
              <a href={`/blog/${p.slug}`} class="group block">
                <div class="aspect-[16/10] overflow-hidden rounded-xl bg-mist">
                  <SiteImage image={p.data.image} class="h-full w-full object-cover" sizes="(min-width: 768px) 33vw, 100vw" widths={[400, 700]} />
                </div>
                <p class="mt-4 font-display text-xs font-semibold text-brand">{p.data.category}</p>
                <h3 class="mt-1 text-xl font-bold text-navy group-hover:text-brand">{p.data.title}</h3>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
