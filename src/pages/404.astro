---
/**
 * Not-found page. Without dist/404.html the host answers unknown URLs with
 * the home page at HTTP 200 (a soft 404), which search engines index as
 * duplicate content.
 */
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import { site } from "@/config/site";

const ui = site.ui;
---

<Layout title={ui.notFoundTitle} description={`${ui.notFoundBody} ${site.business.name}.`}>
  <Nav />
  <main id="main">
    <PageHeader title={ui.notFoundTitle} lede={ui.notFoundBody} />
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-3xl mx-auto">
        <ul class="grid sm:grid-cols-2 gap-3 font-display">
          {site.services.map((s) => <li><a href={`/services/${s.slug}`} class="block rounded-lg bg-mist px-4 py-3 font-semibold text-navy hover:text-brand">{s.name}</a></li>)}
        </ul>
        <a href="/" class="btn-primary mt-10">{ui.backHome}</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
