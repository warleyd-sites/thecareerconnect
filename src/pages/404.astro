---
/**
 * Not-found page.
 *
 * Without this, Astro emits no 404.html and Cloudflare Pages answers every
 * unknown URL with the homepage at HTTP 200 — a soft 404. Search engines treat
 * those as duplicate content, so typos and dead inbound links quietly become
 * copies of the home page in the index.
 *
 * With dist/404.html present, Pages serves it with a real 404 status.
 *
 * The wording here is template chrome, not client copy: the business name,
 * phone and service list all still come from site-data.json.
 */
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { site, telHref, areaLinks } from "@/config/site";
---

<Layout
  title="Page not found"
  description={`That page does not exist. Find ${site.business.trade.toLowerCase()} services from ${site.business.name} in ${site.business.primaryCity}.`}
>
  <Nav />

  <section class="py-16 px-4" style="background-color: var(--color-navy)">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest mb-2" style="color: var(--color-brand)">404</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white mb-3">Page not found</h1>
      <p class="text-gray-300 max-w-2xl">
        That link is broken or the page has moved. Everything {site.business.name} offers is below.
      </p>
    </div>
  </section>

  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Services</h2>
        <ul class="space-y-2 mb-8">
          {site.services.map((s) => (
            <li>
              <a href={`/services/${s.slug}`} class="text-gray-700 hover:underline">
                {s.icon} {s.name}
              </a>
            </li>
          ))}
        </ul>
        <a
          href={telHref}
          class="inline-flex items-center gap-2 px-6 py-4 rounded-lg text-white font-bold transition-opacity hover:opacity-90"
          style="background-color: var(--color-brand)"
        >
          Call {site.business.phone}
        </a>
      </div>

      <div>
        <h2 class="font-display text-2xl font-bold mb-4" style="color: var(--color-navy)">Service areas</h2>
        <ul class="space-y-2 mb-8">
          {areaLinks.map((a) => (
            <li><a href={a.href} class="text-gray-700 hover:underline">{a.name}</a></li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3">
          <a href="/" class="px-4 py-2 rounded-lg border-2 border-gray-200 text-sm font-semibold text-gray-700 hover:border-gray-400 transition-colors">Home</a>
          <a href="/about" class="px-4 py-2 rounded-lg border-2 border-gray-200 text-sm font-semibold text-gray-700 hover:border-gray-400 transition-colors">About</a>
          <a href="/contact" class="px-4 py-2 rounded-lg border-2 border-gray-200 text-sm font-semibold text-gray-700 hover:border-gray-400 transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
