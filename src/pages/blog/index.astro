---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteImage from "@/components/SiteImage.astro";
import { site } from "@/config/site";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = posts;
---

<Layout title={site.blog.heading} description={site.blog.lede}>
  <Nav />
  <main id="main">
    <PageHeader title={site.blog.heading} lede={site.blog.lede} />
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        {lead && (
          <article class="grid md:grid-cols-[1.3fr_1fr] gap-10 items-center border-b border-gray-200 pb-14">
            <a href={`/blog/${lead.slug}`} class="block aspect-[16/10] overflow-hidden rounded-2xl bg-mist" tabindex="-1" aria-hidden="true">
              <SiteImage image={lead.data.image} class="h-full w-full object-cover" sizes="(min-width: 768px) 55vw, 100vw" widths={[600, 1000]} loading="eager" />
            </a>
            <div>
              <p class="font-display text-sm font-semibold text-brand">{lead.data.category}</p>
              <h2 class="mt-2 text-3xl font-extrabold text-navy"><a href={`/blog/${lead.slug}`} class="hover:text-brand">{lead.data.title}</a></h2>
              <p class="mt-4 text-gray-800">{lead.data.description}</p>
              <a href={`/blog/${lead.slug}`} class="btn-primary mt-6">{site.ui.readMore}</a>
            </div>
          </article>
        )}
        <div class="mt-14 grid sm:grid-cols-2 gap-x-10 gap-y-12">
          {rest.map((p) => (
            <article class="grid grid-cols-[8rem_1fr] sm:grid-cols-[10rem_1fr] gap-5">
              <a href={`/blog/${p.slug}`} class="block aspect-square overflow-hidden rounded-xl bg-mist" tabindex="-1" aria-hidden="true">
                <SiteImage image={p.data.image} class="h-full w-full object-cover" sizes="160px" widths={[200, 400]} />
              </a>
              <div>
                <p class="font-display text-xs font-semibold text-brand">{p.data.category}</p>
                <h2 class="mt-1 text-xl font-bold text-navy"><a href={`/blog/${p.slug}`} class="hover:text-brand">{p.data.title}</a></h2>
                <p class="mt-2 text-[0.95rem] text-gray-800 line-clamp-3">{p.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
