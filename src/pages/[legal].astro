---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import { site } from "@/config/site";

export async function getStaticPaths() {
  return (await getCollection("legal")).map((entry) => ({ params: { legal: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"legal"> };
const { Content } = await entry.render();
const updated = entry.data.updated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Layout title={entry.data.title} description={entry.data.description}>
  <Nav />
  <main id="main">
    <PageHeader title={entry.data.title} lede={`${site.ui.lastUpdated} ${updated}`} />
    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <div class="prose-cc"><Content /></div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
