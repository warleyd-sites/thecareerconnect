---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteImage from "@/components/SiteImage.astro";
import CtaBand from "@/components/CtaBand.astro";
import { site } from "@/config/site";

const page = site.pages.about;
---

<Layout title={page.heading} description={page.lede}>
  <Nav />
  <main id="main">
    <PageHeader title={page.heading} lede={page.lede} />

    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-[18rem_1fr] gap-12 items-start">
        <figure>
          <div class="aspect-square overflow-hidden rounded-full ring-8 ring-mist">
            <SiteImage image={site.about.ownerImage} class="h-full w-full object-cover" sizes="288px" widths={[300, 600]} loading="eager" />
          </div>
          <figcaption class="mt-5 text-center font-display">
            <span class="block font-bold text-navy">{site.about.ownerName}</span>
            <span class="block text-sm text-gray-700">{site.about.ownerTitle}</span>
          </figcaption>
        </figure>
        <div>
          <h2 class="text-3xl font-extrabold text-navy">{page.storyHeading}</h2>
          <p class="mt-5 text-lg leading-relaxed text-gray-800">{site.about.story}</p>
          <blockquote class="mt-8 border-l-4 border-accent pl-6 font-body italic text-2xl leading-snug text-navy">“{site.about.ownerQuote}”</blockquote>
        </div>
      </div>
    </section>

    <section class="bg-navy text-white py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.5fr] gap-12">
        <div>
          <h2 class="text-3xl font-extrabold">{page.teamHeading}</h2>
          <p class="mt-4 text-lg text-white/85">{page.teamIntro}</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-8">
          {page.team.map((t) => (
            <div class="border-t-2 border-gold pt-5">
              <h3 class="text-xl font-bold">{t.title}</h3>
              <p class="mt-2 text-white/85">{t.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold text-navy">{page.philosophyHeading}</h2>
        <div class="mt-10 grid md:grid-cols-3 gap-8">
          {page.philosophy.map((p) => (
            <div class="border-t-2 border-gold pt-5">
              <h3 class="text-xl font-bold text-navy">{p.title}</h3>
              <p class="mt-2 text-gray-800">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16 px-4 sm:px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-extrabold text-navy">{page.communityHeading}</h2>
        <p class="mt-4 text-lg text-gray-800">{page.community}</p>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>
