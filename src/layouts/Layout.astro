---
import { getImage } from "astro:assets";
import { site, isProd, schemaType, geoRegion, openingHoursSpec, ATTRIBUTION, type Faq } from "@/config/site";
import "@/styles/global.css";
import { resolveImage } from "@/lib/images";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Pages that visibly render FAQs pass them here, so FAQPage markup only
      appears where the questions are actually on the page. */
  faq?: Faq[];
}

const { title, description = site.seo.description, faq = [] } = Astro.props;

// build.format "file" makes the pathname "/about.html"; the public URL is "/about".
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1") || "/";
const canonical = Astro.site ? new URL(cleanPath, Astro.site).href : null;
const origin = canonical ? new URL("/", canonical).href : null;

// Social preview image: built from the client's own hero photo, made absolute
// so Facebook/X/LinkedIn can fetch it. Skipped entirely when there is no image
// rather than pointing at a file that does not exist.
const ogSource = resolveImage(site.seo.ogImage?.file) ?? resolveImage(site.business.heroImage?.file);
const ogBuilt = ogSource
  ? await getImage({ src: ogSource, width: 1200, height: 630, format: "jpeg" })
  : null;
const ogImageUrl = ogBuilt && Astro.site ? new URL(ogBuilt.src, Astro.site).href : (ogBuilt?.src ?? null);

// ---- Structured data, derived entirely from site-data.json ----
// Nothing here is invented: no aggregateRating, no priceRange, no opening
// hours, because the intake does not supply them.
const localBusiness = {
  "@type": schemaType,
  ...(origin ? { "@id": `${origin}#business`, url: origin } : {}),
  name: site.business.name,
  description: site.seo.description,
  telephone: site.business.phone,
  email: site.business.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.business.streetAddress,
    addressLocality: site.business.primaryCity,
    postalCode: site.business.postalCode,
    addressRegion: geoRegion.replace(/^US-/, ""),
    addressCountry: "US",
  },
  areaServed: site.business.serviceAreas.map((a) => ({ "@type": "State", name: a })),
  founder: { "@type": "Person", name: site.about.ownerName },
  // Real hours from the client's own listing. No aggregateRating here: the
  // reviews live on Google, and marking up someone else's reviews as our own
  // breaches Google's structured-data policy.
  ...(openingHoursSpec.length > 0 ? { openingHoursSpecification: openingHoursSpec } : {}),
};

const serviceNodes = site.services.map((s) => ({
  "@type": "Service",
  name: s.name,
  description: s.description,
  serviceType: s.name,
  provider: { "@type": schemaType, name: site.business.name },
  areaServed: site.business.serviceAreas.map((a) => ({ "@type": "State", name: a })),
}));

const faqNodes =
  faq.length > 0
    ? [
        {
          "@type": "FAQPage",
          mainEntity: faq.map((qa) => ({
            "@type": "Question",
            name: qa.q,
            acceptedAnswer: { "@type": "Answer", text: qa.a },
          })),
        },
      ]
    : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [localBusiness, ...serviceNodes, ...faqNodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} {site.seo.titleSuffix}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Preview deploys must never be indexed — only a PUBLIC_IS_PRODUCTION=true build drops this. */}
    {!isProd && <meta name="robots" content="noindex, nofollow" />}

    <!-- Geo / local SEO -->
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={site.business.primaryCity} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} ${site.seo.titleSuffix}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.business.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {site.seo.ogImage?.alt && <meta property="og:image:alt" content={site.seo.ogImage.alt} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} ${site.seo.titleSuffix}`} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Icons + theme -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={site.colors.primary} />
    {isProd && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@500;600;700;800&display=swap"
      />
    </noscript>

    <!-- Brand colors as CSS variables — values come from site-data.json -->
    <style define:vars={{ brandColor: site.colors.primary, navyColor: site.colors.navy, accentColor: site.colors.accent, goldColor: site.colors.gold, inkColor: site.colors.ink, mistColor: site.colors.mist }}>
      :root {
        --color-brand: var(--brandColor);
        --color-navy: var(--navyColor);
        --color-accent: var(--accentColor);
        --color-gold: var(--goldColor);
        --color-ink: var(--inkColor);
        --color-mist: var(--mistColor);
        --color-brand-dark: color-mix(in srgb, var(--brandColor) 80%, black);
        --color-navy-dark: color-mix(in srgb, var(--navyColor) 70%, black);
        --color-accent-dark: color-mix(in srgb, var(--accentColor) 88%, black);
      }
    </style>
  </head>
  <body class="bg-white text-ink antialiased">
    <a href="#main" class="skip-link">{site.ui.skipLink}</a>
    <slot />
    {/* Arms scroll reveals. Runs at the end of <body>, so elements already in
        view are revealed in the same frame they are hidden — no flash. Skipped
        entirely with reduced motion or without IntersectionObserver. */}
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        document.documentElement.classList.add("js-reveal");
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <p class="text-center py-3 text-xs text-gray-600 bg-white font-display">
      <a href={ATTRIBUTION.url} class="hover:text-ink transition-colors">
        {ATTRIBUTION.text}
      </a>
    </p>
  </body>
</html>
