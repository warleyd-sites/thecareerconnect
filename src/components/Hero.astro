---
import { site, telHref, areaLinks, areasFormatted } from "@/config/site";
import SiteImage from "@/components/SiteImage.astro";
import { hasImage } from "@/lib/images";

// Trust badges come from `home.stats` — the intake's own claims. Nothing
// about licensing, insurance, or guarantees is asserted here, because the
// intake does not capture those.
const stats = site.home.stats ?? [];
const hero = site.business.heroImage;
const showHero = hasImage(hero);
// On the home page the quote form is already below; elsewhere send them to /contact.
const quoteHref = Astro.url.pathname === "/" ? "#quote" : "/contact";
---

{/* The navy gradient is the section's own background, so a hero with no image
    still looks deliberate. When there is an image it sits in a positioned
    wrapper above that background — no negative z-index, which would otherwise
    bury the photo underneath the section it belongs to. */}
<section class="relative py-16 sm:py-24 px-4" style="background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-dark) 100%)">
  {showHero && (
    <div class="absolute inset-0 overflow-hidden">
      <SiteImage
        image={hero}
        class="h-full w-full object-cover"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      {/* Scrim: dark where the text sits, clearing to the right so the photo
          reads. Keeps white text above the WCAG AA contrast floor. */}
      <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(15,35,64,0.92) 0%, rgba(15,35,64,0.78) 45%, rgba(15,35,64,0.45) 100%)"></div>
    </div>
  )}
  <div class="relative max-w-6xl mx-auto">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest mb-3" style="color: var(--color-brand)">
        {site.business.trade} in {site.business.primaryCity} &middot; Serving {areasFormatted}
      </p>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-5">
        {site.business.tagline}
      </h1>
      <p class="text-lg sm:text-xl text-gray-300 mb-8 leading-relaxed">
        {site.business.pitch}
      </p>

      <div class="flex flex-wrap gap-4 mb-8">
        <a
          href={telHref}
          class="inline-flex items-center gap-2 px-6 py-4 rounded-lg text-white font-bold text-base transition-opacity hover:opacity-90"
          style="background-color: var(--color-brand)"
        >
          Call {site.business.phone}
        </a>
        <!-- Von Restorff: secondary CTA — visually subordinate to the phone call primary -->
        <a
          href={quoteHref}
          class="inline-flex items-center gap-2 px-6 py-4 rounded-lg font-semibold text-base border-2 border-white/30 text-white/80 hover:border-white/60 hover:text-white transition-colors"
        >
          Request a Quote
        </a>
      </div>

      <!-- Service area chips for SEO + UX -->
      <div class="flex flex-wrap gap-2 mb-6">
        {areaLinks.map((area) => (
          <a
            href={area.href}
            class="inline-flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-full border border-white/20 text-white/85 hover:bg-white/10 transition-colors"
          >
            {site.business.trade} in {area.name} →
          </a>
        ))}
      </div>

      {stats.length > 0 && (
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400">
          {stats.map((stat) => (
            <span>✓ {stat}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
