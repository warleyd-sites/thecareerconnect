---
/**
 * A testimonial that loads YouTube only when played. Until then it is a
 * local thumbnail and a button — no third-party requests or cookies on page
 * load. Playback uses youtube-nocookie.com.
 */
import { site, fill } from "@/config/site";
import SiteImage from "@/components/SiteImage.astro";
import Icon from "@/components/Icon.astro";

interface Props {
  item: (typeof site.testimonials.items)[number];
}
const { item } = Astro.props;
const label = fill(site.ui.watchTestimonial, { name: item.name.split(" ")[0] });
---

<figure class="group">
  <div class="yt relative aspect-[4/5] overflow-hidden rounded-[22px] bg-navy" data-id={item.youtubeId} data-title={item.name}>
    <SiteImage image={item.image} class="photo-zoom absolute inset-0 h-full w-full object-cover" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 85vw" widths={[400, 700]} />
    <button type="button" class="yt-play absolute inset-0 flex items-end justify-start p-5" aria-label={label}>
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-navy shadow-lg transition-transform group-hover:scale-105">
        <Icon name="play" class="w-7 h-7 ml-1" />
      </span>
    </button>
  </div>
  <figcaption class="mt-4 font-display">
    <span class="block text-[1.35rem] font-extrabold text-navy">{item.name}</span>
    <span class="block text-sm text-gray-700">{item.detail}</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".yt").forEach((box) => {
    box.querySelector(".yt-play")?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? "";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
