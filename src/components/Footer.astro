---
import { site, telHref, mailtoHref, areaLinks } from "@/config/site";
---

<footer class="py-12 px-4" style="background-color: var(--color-navy)">
  <div class="max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <div>
        <h3 class="font-display text-lg font-bold text-white mb-3">{site.business.name}</h3>
        <p class="text-gray-400 text-sm leading-relaxed">{site.business.pitch}</p>
      </div>

      <nav aria-label="Site links">
        <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Site</h4>
        <ul class="space-y-1">
          <li><a href="/" class="text-gray-400 text-sm hover:text-white transition-colors block py-1">Home</a></li>
          <li><a href="/services" class="text-gray-400 text-sm hover:text-white transition-colors block py-1">Services</a></li>
          <li><a href="/about" class="text-gray-400 text-sm hover:text-white transition-colors block py-1">About</a></li>
          <li><a href="/contact" class="text-gray-400 text-sm hover:text-white transition-colors block py-1">Contact</a></li>
        </ul>
      </nav>

      <nav aria-label="Service area links">
        <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Service Areas</h4>
        <ul class="space-y-1">
          {
            areaLinks.map((area) => (
              <li>
                <a
                  href={area.href}
                  class="text-gray-400 text-sm hover:text-white transition-colors block py-1"
                >
                  {area.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h4 class="text-sm font-semibold text-gray-300 uppercase tracking-wider mb-3">Contact</h4>
        <div class="space-y-2">
          <a
            href={telHref}
            class="block text-sm font-bold text-white hover:opacity-80 transition-opacity"
          >
            {site.business.phone}
          </a>
          <a href={mailtoHref} class="block text-sm text-gray-400 hover:text-white transition-colors">
            {site.business.email}
          </a>
          <p class="text-sm text-gray-400">{site.business.address}</p>
        </div>

      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-center gap-3 text-xs text-gray-500">
      <span>© {new Date().getFullYear()} {site.business.name}. All rights reserved.</span>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a href="/privacy" class="hover:text-gray-300 transition-colors">Privacy Policy</a>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a href="/terms" class="hover:text-gray-300 transition-colors">Terms of Service</a>
      <span class="hidden sm:inline" aria-hidden="true">·</span>
      <a href="/credits" class="hover:text-gray-300 transition-colors">Photo credits</a>
    </div>
  </div>
</footer>
