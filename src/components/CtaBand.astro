---
import { site, telHref } from "@/config/site";
import Icon from "@/components/Icon.astro";
import ContactForm from "@/components/ContactForm.astro";

const home = site.home;
---

<section id="contact" class="bg-mist py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.1fr] gap-12 items-start">
    <div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-navy">{home.ctaHeading}</h2>
      <p class="mt-4 text-lg text-gray-800">{home.ctaBody}</p>
      <ul class="mt-8 space-y-4">
        {home.ctaBullets.map((b) => (
          <li class="flex gap-3">
            <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy text-accent"><Icon name="check" class="w-4 h-4" /></span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
      <a href={telHref} class="mt-10 inline-flex items-center gap-3 font-display text-2xl font-extrabold text-navy hover:text-brand">
        <Icon name="phone" class="w-7 h-7 text-accent" />{site.business.phone}
      </a>
    </div>
    <ContactForm />
  </div>
</section>
