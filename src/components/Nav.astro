---
import { site, telHref } from "@/config/site";
import Logo from "@/components/Logo.astro";
import BookingButton from "@/components/BookingButton.astro";

const ui = site.ui.nav;
const links = [
  { href: "/about", label: ui.about },
  { href: "/pricing", label: ui.pricing },
  { href: "/testimonials", label: ui.testimonials },
  { href: "/blog", label: ui.blog },
  { href: "/contact", label: ui.contact },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-200">
  <div class="px-4 sm:px-6"><nav aria-label="Main" class="max-w-6xl mx-auto flex items-center justify-between h-[4.5rem] gap-6">
    <a href="/" aria-label={site.business.name} class="shrink-0">
      <Logo />
    </a>

    <div class="hidden lg:flex items-center gap-7 font-display text-[0.9rem] font-semibold text-ink">
      <div class="nav-dropdown">
        <a href="/services" class="nav-link inline-flex items-center gap-1" aria-current={isCurrent("/services") ? "page" : undefined}>
          {ui.services}
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z" /></svg>
        </a>
        <div class="nav-dropdown-panel">
          <ul class="py-2">
            {site.services.map((s) => (
              <li><a href={`/services/${s.slug}`} class="block px-4 py-2.5 text-sm hover:bg-mist">{s.name}</a></li>
            ))}
            <li class="border-t border-gray-100 mt-1 pt-1">
              <a href="/services" class="block px-4 py-2.5 text-sm text-brand hover:bg-mist">{ui.allServices}</a>
            </li>
          </ul>
        </div>
      </div>
      {links.map((l) => (
        <a href={l.href} class="nav-link" aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <span class="hidden sm:block"><BookingButton class="btn-primary !py-2.5 !px-5 !text-sm" /></span>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label={ui.openMenu}
        data-open-label={ui.openMenu}
        data-close-label={ui.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-navy hover:bg-mist"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav></div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 bg-white font-display">
    <div class="px-4 py-4 max-h-[80vh] overflow-y-auto">
      <p class="px-3 pb-1 text-xs font-semibold text-gray-600">{ui.services}</p>
      <ul>
        {site.services.map((s) => (
          <li><a href={`/services/${s.slug}`} class="block px-3 py-2.5 rounded-lg text-[0.95rem] text-ink hover:bg-mist">{s.name}</a></li>
        ))}
      </ul>
      <div class="border-t border-gray-200 my-2"></div>
      <ul>
        {links.map((l) => (
          <li><a href={l.href} class="block px-3 py-3 rounded-lg text-base font-semibold text-ink hover:bg-mist">{l.label}</a></li>
        ))}
      </ul>
      <div class="grid gap-2 mt-3">
        <BookingButton />
        <a href={telHref} class="btn-secondary text-navy">{ui.call} {site.business.phone}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    padding: 0.4rem 0;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-brand);
  }
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
  }
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown-panel {
    position: absolute;
    top: 100%;
    left: -1rem;
    margin-top: 14px;
    min-width: 250px;
    background: white;
    border: 1px solid #e5e7eb;
    border-top: 3px solid var(--color-accent);
    border-radius: 0 0 10px 10px;
    box-shadow: 0 16px 32px rgb(5 38 73 / 0.12);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
    z-index: 60;
  }
  .nav-dropdown:hover .nav-dropdown-panel,
  .nav-dropdown:focus-within .nav-dropdown-panel {
    opacity: 1;
    visibility: visible;
  }
  /* invisible bridge so the panel doesn't close in the gap */
  .nav-dropdown::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 18px;
  }
</style>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const willOpen = menu?.classList.contains("hidden") ?? false;
    menu?.classList.toggle("hidden");
    document.getElementById("menu-icon-open")?.classList.toggle("hidden");
    document.getElementById("menu-icon-close")?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(willOpen));
    btn.setAttribute("aria-label", (willOpen ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? "");
  });
</script>
