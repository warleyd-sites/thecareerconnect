---
import { site, areasFormatted } from "@/config/site";
import SiteImage from "@/components/SiteImage.astro";
---

<section class="py-16 px-4 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <h2 class="font-display text-3xl sm:text-4xl font-bold text-center mb-2" style="color: var(--color-navy)">
      What We Do
    </h2>
    <p class="text-center text-gray-600 mb-10">
      Serving {areasFormatted}
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        site.services.map((service) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow overflow-hidden">
            <SiteImage
              image={service.image}
              class="h-40 w-full object-cover"
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
            />
            <div class="p-6">
            <div class="text-3xl mb-3">{service.icon}</div>
            <h3 class="font-display text-xl font-semibold mb-2" style="color: var(--color-navy)">
              {service.name}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-10">
      <a
        href="/services"
        class="inline-flex items-center gap-2 font-semibold text-sm min-h-[44px] px-4 py-3 rounded-lg hover:bg-gray-100 transition-colors"
        style="color: var(--color-brand)"
      >
        View all services →
      </a>
    </div>
  </div>
</section>
