---
import { site, type Faq } from "@/config/site";

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="py-16 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-extrabold text-navy">{site.ui.faqHeading}</h2>
      <div class="mt-8 divide-y divide-gray-200 border-y border-gray-200">
        {items.map((qa) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-bold text-navy">
              {qa.q}
              <span aria-hidden="true" class="text-2xl leading-none text-accent transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-800">{qa.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
