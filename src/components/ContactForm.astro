---
import { site, telHref, fill } from "@/config/site";

const f = site.form;
const input =
  "w-full rounded-lg border border-gray-300 bg-white px-4 py-3 font-display text-[0.95rem] text-ink focus:outline-none focus:ring-2 focus:ring-brand focus:border-brand";
const label = "block font-display text-sm font-semibold text-navy mb-1.5";
---

<div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-[0_20px_40px_-24px_rgb(5_38_73/0.35)]">
  <h2 class="text-2xl font-bold text-navy">{f.heading}</h2>
  <p class="mt-2 mb-6 text-[0.95rem] text-gray-700">{f.intro}</p>

  <form
    id="contact-form"
    class="space-y-4"
    novalidate
    data-sending={f.sending}
    data-sent={f.sent}
    data-send-another={f.sendAnother}
    data-retry={f.retry}
    data-submit={f.submit}
    data-failed={fill(f.failed, { phone: site.business.phone })}
    data-error-name={f.errors.name}
    data-error-email={f.errors.email}
    data-error-message={f.errors.message}
  >
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label for="cf-name" class={label}>{f.name}</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="120" aria-describedby="cf-name-error" class={input} />
        <p id="cf-name-error" class="field-error hidden" aria-live="polite"></p>
      </div>
      <div>
        <label for="cf-email" class={label}>{f.email}</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="200" aria-describedby="cf-email-error" class={input} />
        <p id="cf-email-error" class="field-error hidden" aria-live="polite"></p>
      </div>
      <div>
        <label for="cf-phone" class={label}>{f.phone}</label>
        <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" class={input} />
      </div>
      <div>
        <label for="cf-role" class={label}>{f.role}</label>
        <select id="cf-role" name="role" class={input}>
          {f.roles.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>
    </div>
    <div>
      <label for="cf-org" class={label}>{f.organization}</label>
      <input id="cf-org" name="organization" type="text" autocomplete="organization" maxlength="200" class={input} />
    </div>
    <div>
      <label for="cf-message" class={label}>{f.message}</label>
      <textarea id="cf-message" name="message" rows="4" required maxlength="5000" aria-describedby="cf-message-hint cf-message-error" class={`${input} resize-y`}></textarea>
      <p id="cf-message-hint" class="mt-1 text-xs text-gray-600 font-display">{f.messageHint}</p>
      <p id="cf-message-error" class="field-error hidden" aria-live="polite"></p>
    </div>
    {/* Honeypot: hidden from people, filled in by naive bots. */}
    <div class="hidden" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" id="cf-submit" class="btn-primary w-full disabled:opacity-60 disabled:cursor-not-allowed">{f.submit}</button>
    <p id="cf-status" role="status" aria-live="polite" class="hidden text-center text-sm font-display font-semibold"></p>
  </form>

  <p class="text-center text-sm text-gray-700 mt-5 font-display">
    <a href={telHref} class="hover:underline">{fill(f.orCall, { phone: site.business.phone })}</a>
  </p>
</div>

<style>
  .field-error {
    margin-top: 0.3rem;
    font-family: "Montserrat", sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: #b42318;
  }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    const d = form.dataset;
    const btn = document.getElementById("cf-submit") as HTMLButtonElement;
    const status = document.getElementById("cf-status") as HTMLParagraphElement;
    const required = {
      name: document.getElementById("cf-name") as HTMLInputElement,
      email: document.getElementById("cf-email") as HTMLInputElement,
      message: document.getElementById("cf-message") as HTMLTextAreaElement,
    };
    const messages: Record<keyof typeof required, string> = {
      name: d.errorName ?? "",
      email: d.errorEmail ?? "",
      message: d.errorMessage ?? "",
    };
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function setError(key: keyof typeof required, text: string | null) {
      const el = required[key];
      const span = document.getElementById(`cf-${key}-error`)!;
      el.setAttribute("aria-invalid", text ? "true" : "false");
      el.classList.toggle("border-red-600", Boolean(text));
      span.textContent = text ?? "";
      span.classList.toggle("hidden", !text);
    }

    function check(key: keyof typeof required): boolean {
      const v = required[key].value.trim();
      const ok = key === "email" ? EMAIL.test(v) : v.length > 0;
      setError(key, ok ? null : messages[key]);
      return ok;
    }

    (Object.keys(required) as (keyof typeof required)[]).forEach((k) => {
      required[k].addEventListener("blur", () => required[k].value && check(k));
      required[k].addEventListener("input", () => required[k].getAttribute("aria-invalid") === "true" && check(k));
    });

    function showStatus(text: string, ok: boolean) {
      status.textContent = text;
      status.setAttribute("role", ok ? "status" : "alert");
      status.className = `text-center text-sm font-display font-semibold ${ok ? "text-green-800" : "text-red-700"}`;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const results = (Object.keys(required) as (keyof typeof required)[]).map((k) => [k, check(k)] as const);
      const firstBad = results.find(([, ok]) => !ok);
      if (firstBad) {
        required[firstBad[0]].focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = d.sending ?? "";
      form.setAttribute("aria-busy", "true");
      status.classList.add("hidden");

      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          form.reset();
          showStatus(d.sent ?? "", true);
          btn.textContent = d.sendAnother ?? "";
        } else {
          const body = await res.json().catch(() => ({}));
          if (body?.field && body.field in required) {
            setError(body.field, body.error ?? messages[body.field as keyof typeof required]);
            required[body.field as keyof typeof required].focus();
            btn.textContent = d.retry ?? "";
          } else {
            throw new Error("send failed");
          }
        }
      } catch {
        showStatus(d.failed ?? "", false);
        btn.textContent = d.retry ?? "";
      } finally {
        btn.disabled = false;
        form.removeAttribute("aria-busy");
      }
    });
  }
</script>
