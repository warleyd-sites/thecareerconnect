---
import { site, telHref } from "@/config/site";
---

<div class="bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
  <h3 class="font-display text-2xl font-bold mb-6" style="color: var(--color-navy)">Request a Quote</h3>

  <form id="contact-form" class="space-y-4">
    <div>
      <label for="contact-name" class="block text-sm font-semibold text-gray-700 mb-1">Your Name</label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        autocomplete="name"
        placeholder="John Smith"
        aria-describedby="contact-name-error"
        class="w-full rounded-lg border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all"
      />
      <span id="contact-name-error" class="hidden text-xs text-red-600 mt-1 block" aria-live="polite"></span>
    </div>
    <div>
      <label for="contact-phone" class="block text-sm font-semibold text-gray-700 mb-1">Phone</label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder="(000) 000-0000"
        aria-describedby="contact-phone-error"
        class="w-full rounded-lg border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all"
      />
      <span id="contact-phone-error" class="hidden text-xs text-red-600 mt-1 block" aria-live="polite"></span>
    </div>
    <div>
      <label for="contact-message" class="block text-sm font-semibold text-gray-700 mb-1">What do you need?</label>
      <textarea
        id="contact-message"
        name="message"
        rows="3"
        required
        placeholder="Describe the issue or job..."
        aria-describedby="contact-message-error"
        class="w-full rounded-lg border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent transition-all resize-y"
      ></textarea>
      <span id="contact-message-error" class="hidden text-xs text-red-600 mt-1 block" aria-live="polite"></span>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="w-full py-4 rounded-lg text-white font-bold text-base transition-all hover:opacity-90 disabled:opacity-60 disabled:cursor-not-allowed"
      style="background-color: var(--color-brand)"
    >
      Send Request →
    </button>

    <p id="form-msg" role="status" aria-live="polite" class="text-center text-sm hidden"></p>
  </form>

  <p class="text-center text-gray-600 text-xs mt-4">
    Or call us directly: <a href={telHref} class="font-semibold text-gray-600">{site.business.phone}</a>
  </p>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const msg = document.getElementById("form-msg") as HTMLParagraphElement;

  const fields = {
    name: document.getElementById("contact-name") as HTMLInputElement,
    phone: document.getElementById("contact-phone") as HTMLInputElement,
    message: document.getElementById("contact-message") as HTMLTextAreaElement,
  };

  const errorSpans = {
    name: document.getElementById("contact-name-error") as HTMLSpanElement,
    phone: document.getElementById("contact-phone-error") as HTMLSpanElement,
    message: document.getElementById("contact-message-error") as HTMLSpanElement,
  };

  const VALID_CLASSES = "border-green-400 ring-1 ring-green-400";
  const INVALID_CLASSES = "border-red-400 ring-1 ring-red-400";
  const DEFAULT_CLASSES = "border-gray-200";

  function clearFieldState(el: HTMLInputElement | HTMLTextAreaElement, span: HTMLSpanElement) {
    el.classList.remove(...VALID_CLASSES.split(" "), ...INVALID_CLASSES.split(" "));
    el.classList.add(...DEFAULT_CLASSES.split(" "));
    span.textContent = "";
    span.classList.add("hidden");
  }

  function setFieldError(el: HTMLInputElement | HTMLTextAreaElement, span: HTMLSpanElement, message: string) {
    el.classList.remove(...VALID_CLASSES.split(" "), ...DEFAULT_CLASSES.split(" "));
    el.classList.add(...INVALID_CLASSES.split(" "));
    span.textContent = message;
    span.classList.remove("hidden");
  }

  function setFieldValid(el: HTMLInputElement | HTMLTextAreaElement, span: HTMLSpanElement) {
    el.classList.remove(...INVALID_CLASSES.split(" "), ...DEFAULT_CLASSES.split(" "));
    el.classList.add(...VALID_CLASSES.split(" "));
    span.textContent = "";
    span.classList.add("hidden");
  }

  function validateName(): boolean {
    const val = fields.name.value.trim();
    if (!val) {
      setFieldError(fields.name, errorSpans.name, "Please enter your name.");
      return false;
    }
    setFieldValid(fields.name, errorSpans.name);
    return true;
  }

  function validatePhone(): boolean {
    const digits = fields.phone.value.replace(/\D/g, "");
    if (!digits) {
      setFieldError(fields.phone, errorSpans.phone, "Please enter your phone number.");
      return false;
    }
    if (digits.length < 10) {
      setFieldError(fields.phone, errorSpans.phone, "Please enter a valid 10-digit phone number.");
      return false;
    }
    setFieldValid(fields.phone, errorSpans.phone);
    return true;
  }

  function validateMessage(): boolean {
    const val = fields.message.value.trim();
    if (!val) {
      setFieldError(fields.message, errorSpans.message, "Please describe what you need.");
      return false;
    }
    setFieldValid(fields.message, errorSpans.message);
    return true;
  }

  fields.name.addEventListener("blur", validateName);
  fields.phone.addEventListener("blur", validatePhone);
  fields.message.addEventListener("blur", validateMessage);

  // Clear field-level error on input so user gets immediate feedback while correcting
  fields.name.addEventListener("input", () => {
    if (fields.name.value.trim()) clearFieldState(fields.name, errorSpans.name);
  });
  fields.phone.addEventListener("input", () => {
    if (fields.phone.value.replace(/\D/g, "").length >= 10) clearFieldState(fields.phone, errorSpans.phone);
  });
  fields.message.addEventListener("input", () => {
    if (fields.message.value.trim()) clearFieldState(fields.message, errorSpans.message);
  });

  form?.addEventListener("submit", async (e) => {
    // Peak-End Rule: PEAK moment — submit tap. Button feedback must be instant and unambiguous.
    e.preventDefault();

    // Validate all fields before submit
    const nameOk = validateName();
    const phoneOk = validatePhone();
    const messageOk = validateMessage();
    if (!nameOk || !phoneOk || !messageOk) return;

    btn.disabled = true;
    form.setAttribute("aria-busy", "true");
    btn.textContent = "Sending...";
    msg.textContent = "";
    msg.className = "text-center text-sm hidden";

    // Normalize inputs before sending
    const name = fields.name.value.trim();
    const phone = fields.phone.value.replace(/\D/g, "");
    const message = fields.message.value.trim();

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, phone, message }),
      });

      if (res.ok) {
        form.reset();
        // Clear all field valid states after reset
        (["name", "phone", "message"] as const).forEach((k) =>
          clearFieldState(fields[k], errorSpans[k])
        );
        msg.setAttribute("role", "status");
        // Peak-End Rule: END of the primary conversion flow — warm, specific confirmation.
        msg.textContent = "✓ Request sent — we'll be in touch.";
        msg.className = "text-center text-sm text-green-700 font-semibold";
        msg.classList.remove("hidden");
        btn.textContent = "Sent ✓";
        btn.setAttribute("aria-disabled", "true");
        form.removeAttribute("aria-busy");
        setTimeout(() => {
          btn.disabled = false;
          btn.removeAttribute("aria-disabled");
          btn.textContent = "Send Another Request →";
          msg.classList.add("hidden");
        }, 4000);
      } else {
        // Map server errors to specific fields when the API tells us which field failed
        const body = await res.json().catch(() => ({}));
        if (body?.field && body.field in errorSpans) {
          const fieldKey = body.field as keyof typeof fields;
          setFieldError(fields[fieldKey], errorSpans[fieldKey], body.error ?? "Invalid value.");
          fields[fieldKey].focus();
        } else {
          throw new Error("failed");
        }
        btn.disabled = false;
        btn.textContent = "Try Again →";
        form.removeAttribute("aria-busy");
      }
    } catch {
      msg.setAttribute("role", "alert");
      msg.textContent = "Message not sent — check your connection and try again, or call us directly.";
      msg.className = "text-center text-sm text-red-600 font-medium";
      msg.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Try Again →";
      form.removeAttribute("aria-busy");
    }
  });
</script>
