---
/**
 * Header lockup: the client's logo mark (src/images/logo-mark.png, cut from
 * the logo they supplied 2026-10-01) beside the wordmark set in the logo's
 * own type and colors. The full stacked logo is too small to read at header
 * height, so the footer carries it instead (Footer.astro, logo-full.png).
 */
import { site } from "@/config/site";
import SiteImage from "@/components/SiteImage.astro";

interface Props {
  /** "dark" sits on the navy footer/hero. */
  tone?: "light" | "dark";
  class?: string;
}
const { tone = "light", class: className = "" } = Astro.props;

const [first, ...rest] = site.business.shortName.split(" ");
const second = rest.join(" ");
const suffix = site.business.name.replace(site.business.shortName, "").trim();
const firstColor = tone === "dark" ? "#ffffff" : "var(--color-brand)";
const suffixColor = tone === "dark" ? "rgb(255 255 255 / 0.85)" : "var(--color-ink)";
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <SiteImage image={{ file: "logo-mark.png", alt: "" }} class="h-9 sm:h-10 w-auto shrink-0" sizes="68px" widths={[68, 136, 204]} loading="eager" />
  {/* The lockup is a logotype, read as one name: assistive tech gets the
      business name once from aria-label. The letters are drawn by CSS
      (::before content) so contrast checkers treat them as the logo they are
      (logotypes are exempt from WCAG 1.4.3) rather than as body text. Swap
      for a vector logo if the client supplies one. */}
  <span class="flex flex-col leading-none font-display" role="img" aria-label={site.business.name}>
    <span class="text-[1.05rem] sm:text-[1.2rem] font-extrabold tracking-tight">
      <span class="logo-word" style={`color:${firstColor}`} data-word={first.toUpperCase()}></span>
      <span class="logo-word" style="color: var(--color-accent)" data-word={second.toUpperCase()}></span>
    </span>
    {suffix && (
      <span class="gold-rule mt-1 text-[0.58rem] font-semibold tracking-[0.18em]">
        <span class="logo-word" style={`color:${suffixColor}`} data-word={suffix.toUpperCase()}></span>
      </span>
    )}
  </span>
</span>

<style>
  .logo-word::before {
    content: attr(data-word);
  }
</style>
