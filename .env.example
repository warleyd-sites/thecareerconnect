# Contact form (api/contact.ts). Set these in Vercel → Project → Settings → Environment Variables.
# Resend API key — WarleyD's Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where form messages are delivered. Defaults to business.email in src/site-data.json.
CONTACT_TO_EMAIL=
# Sender address; must be on a domain verified in Resend. Defaults to noreply@warleyd.com.
CONTACT_FROM_EMAIL=
# Set to "true" only on the production deployment — removes noindex and adds the sitemap.
PUBLIC_IS_PRODUCTION=
